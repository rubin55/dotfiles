{
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "language_models": {
    "opencode": {
      "show_go_models": false
    }
  },
  "text_rendering_mode": "grayscale",
  "edit_predictions": {
    "provider": "none"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_buffer_font_size": 14,
  "auto_update": false,
  "buffer_font_family": "PragmataPro Mono",
  "buffer_font_size": 15,
  "buffer_font_weight": 100,
  "buffer_line_height": "standard",
  "cursor_shape": "block",
  "hard_tabs": false,
  "middle_click_paste": true,
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",
  "ui_font_family": "Ubuntu",
  "ui_font_size": 16,
  "ui_font_weight": 399,
  "vim_mode": false,
  "wrap_guides": [
    80,
    120
  ],
  "agent": {
    "sidebar_side": "right",
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "network_hosts": []
    },
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
    "enable_feedback": false,
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "xhigh",
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "meta/muse-spark-1.3-contributor"
    },
    "enabled": true,
    "button": true
  },
  "auto_install_extensions": {
    "ansible": true,
    "astro": true,
    "catppuccin": true,
    "clojure": true,
    "csharp": true,
    "cue": true,
    "cypher": true,
    "dart": true,
    "dockerfile": true,
    "elixir": true,
    "erlang": true,
    "fsharp": true,
    "groovy": true,
    "haskell": true,
    "helm": true,
    "html": true,
    "java": true,
    "kotlin": true,
    "lua": true,
    "make": true,
    "perl": true,
    "ruby": true,
    "scala": true,
    "scheme": true,
    "sql": true,
    "svelte": true,
    "swift": true,
    "toml": true,
    "xml": true,
    "zig": true
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml"
    ],
    "Dockerfile": [
      "Dockerfile",
      "Dockerfile.*",
      "*.Dockerfile"
    ],
    "Groovy": [
      "*.groovy"
    ],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml"
    ],
    "Markdown": [
      "**/Project Notes/*"
    ],
    "Shell Script": [
      ".bash_functions"
    ]
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 1000
    }
  },
  "indent_guides": {
    "enabled": false,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  "journal": {
    "path": "~",
    "hour_format": "hour24"
  },
  "project_panel": {
    "dock": "left",
    "scrollbar": {
      "show": "never"
    }
  },
  "languages": {
    "Ansible": {
      "language_servers": [
        "ansible"
      ]
    },
    "Dockerfile": {
      "language_servers": [
        "dockerfile-language-server"
      ]
    },
    "Elixir": {
      "language_servers": [
        "expert"
      ]
    },
    "Groovy": {
      "language_servers": [
        "groovy"
      ]
    },
    "Helm": {
      "language_servers": [
        "helm"
      ]
    },
    "Kotlin": {
      "language_servers": [
        "kotlin-lsp"
      ]
    },
    "Python": {
      "language_servers": [
        "pylsp",
        "!pyright"
      ]
    },
    "Ruby": {
      "language_servers": [
        "solargraph",
        "rubocop",
        "!ruby-lsp"
      ]
    },
    "Svelte": {
      "language_servers": [
        "svelte-language-server"
      ]
    },
    "Erlang": {
      "language_servers": [
        "elp"
      ]
    },
    "CSharp": {
      "language_servers": [
        "roslyn"
      ]
    },
    "Perl": {
      "language_servers": [
        "perlnavigator-server"
      ]
    },
    "Java": {
      "language_servers": [
        "jdtls"
      ]
    }
  },
  "lsp": {
    "ansible": {
      "binary": {
        "path": "/usr/bin/ansible-language-server",
        "arguments": [
          "--stdio"
        ]
      }
    },
    "dockerfile-language-server": {
      "binary": {
        "path": "/usr/bin/docker-langserver",
        "arguments": [
          "--stdio"
        ]
      }
    },
    "groovy": {
      "binary": {
        "path": "/usr/bin/groovy-language-server"
      }
    },
    "helm": {
      "binary": {
        "path": "/usr/bin/helm_ls",
        "arguments": [
          "serve"
        ]
      }
    },
    "metals": {
      "initialization_options": {
        "isHttpEnabled": true
      },
      "settings": {
        "inlayHints": {
          "inferredTypes": {
            "enable": true
          },
          "implicitArguments": {
            "enable": true
          },
          "implicitConversions": {
            "enable": true
          },
          "typeParameters": {
            "enable": true
          },
          "hintsInPatternMatch": {
            "enable": true
          }
        }
      },
      "binary": {
        "path": "/usr/bin/metals"
      }
    },
    "rust-analyzer": {
      "binary": {
        "path": "/usr/lib/rustup/bin/rust-analyzer"
      },
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "completion": {
          "fullFunctionSignatures": {
            "enable": true
          }
        },
        "hover": {
          "maxSubstitutionLength": null,
          "show": {
            "enumVariants": 100,
            "fields": 100
          }
        }
      }
    },
    "solargraph": {
      "initialization_options": {
        "diagnostics": true,
        "formatting": true
      },
      "settings": {
        "use_bundler": false
      },
      "binary": {
        "path": "/usr/bin/solargraph",
        "arguments": [
          "stdio"
        ]
      }
    },
    "svelte-language-server": {
      "binary": {
        "path": "/usr/bin/svelteserver",
        "arguments": [
          "--stdio"
        ]
      },
      "settings": {
        "javascript.inlayHints.enumMemberValues.enabled": false,
        "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
        "javascript.inlayHints.parameterNames.enabled": "none",
        "javascript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
        "javascript.inlayHints.parameterTypes.enabled": false,
        "javascript.inlayHints.propertyDeclarationTypes.enabled": false,
        "javascript.inlayHints.variableTypes.enabled": false,
        "javascript.inlayHints.variableTypes.suppressWhenTypeMatchesName.enabled": true,
        "typescript.inlayHints.enumMemberValues.enabled": false,
        "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
        "typescript.inlayHints.parameterNames.enabled": "none",
        "typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
        "typescript.inlayHints.parameterTypes.enabled": false,
        "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
        "typescript.inlayHints.variableTypes.enabled": false,
        "typescript.inlayHints.variableTypes.suppressWhenTypeMatchesName.enabled": true
      },
      "initialization_options": {
        "configuration": {
          "svelte": {
            "plugin": {
              "css": {
                "enable": true,
                "globals": "",
                "colorPresentations": {
                  "enable": true
                },
                "completions": {
                  "enable": true,
                  "emmet": true
                },
                "diagnostics": {
                  "enable": true
                },
                "documentColors": {
                  "enable": true
                },
                "documentSymbols": {
                  "enable": true
                },
                "hover": {
                  "enable": true
                },
                "selectionRange": {
                  "enable": true
                }
              },
              "html": {
                "enable": true,
                "completions": {
                  "enable": true,
                  "emmet": true
                },
                "documentSymbols": {
                  "enable": true
                },
                "hover": {
                  "enable": true
                },
                "linkedEditing": {
                  "enable": true
                },
                "renameTags": {
                  "enable": true
                },
                "tagComplete": {
                  "enable": true
                }
              },
              "svelte": {
                "enable": true,
                "codeActions": {
                  "enable": true
                },
                "compilerWarnings": {},
                "completions": {
                  "enable": true
                },
                "useNewTransformation": false,
                "diagnostics": {
                  "enable": true
                },
                "format": {
                  "enable": true
                },
                "hover": {
                  "enable": true
                },
                "rename": {
                  "enable": true
                },
                "selectionRange": {
                  "enable": true
                }
              },
              "typescript": {
                "enable": true,
                "codeActions": {
                  "enable": true
                },
                "completions": {
                  "enable": true
                },
                "definitions": {
                  "enable": true
                },
                "diagnostics": {
                  "enable": true
                },
                "documentSymbols": {
                  "enable": true
                },
                "findReferences": {
                  "enable": true
                },
                "hover": {
                  "enable": true
                },
                "rename": {
                  "enable": true
                },
                "selectionRange": {
                  "enable": true
                },
                "semanticTokens": {
                  "enable": true
                },
                "signatureHelp": {
                  "enable": true
                }
              }
            }
          }
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "completion": true,
          "customTags": [
            "!reference sequence"
          ],
          "maxItemsComputed": 5000,
          "editor": {
            "tabSize": 2
          },
          "format": {
            "enable": true,
            "singleQuote": false,
            "bracketSpacing": true,
            "proseWrap": "preserve",
            "printWidth": 120
          },
          "hover": true,
          "schemas": {},
          "schemaStore": {
            "enable": true
          },
          "validate": true,
          "disableAdditionalProperties": false
        }
      },
      "binary": {
        "path": "/usr/bin/yaml-language-server",
        "arguments": [
          "--stdio"
        ]
      }
    },
    "astro-language-server": {
      "binary": {
        "path": "/usr/bin/astro-ls",
        "arguments": [
          "--stdio"
        ]
      },
      "initialization_options": {
        "diagnosticModel": 2,
        "typescript.tsdk": "/usr/lib/node_modules/typescript/lib"
      },
      "settings": {
        "astro.typescript.enabled": true,
        "astro.typescript.allowArbitraryAttributes": false,
        "astro.typescript.diagnostics.enabled": true,
        "astro.typescript.hover.enabled": true,
        "astro.typescript.documentSymbols.enabled": true,
        "astro.typescript.completions.enabled": true,
        "astro.typescript.definitions.enabled": true,
        "astro.typescript.codeActions.enabled": true,
        "astro.typescript.signatureHelp.enabled": true,
        "astro.typescript.rename.enabled": true,
        "astro.typescript.semanticTokens.enabled": true,
        "astro.html.enabled": true,
        "astro.html.hover.enabled": true,
        "astro.html.completions.enabled": true,
        "astro.html.completions.emmet": true,
        "astro.html.tagComplete.enabled": true,
        "astro.html.documentSymbols.enabled": true,
        "astro.css.enabled": true,
        "astro.css.hover.enabled": true,
        "astro.css.completions.enabled": true,
        "astro.css.completions.emmet": true,
        "astro.css.documentColors.enabled": true,
        "astro.css.documentSymbols.enabled": true,
        "astro.format.indentFrontmatter": false,
        "astro.format.newLineAfterFrontmatter": true
      }
    },
    "dart": {
      "binary": {
        "path": "dart",
        "arguments": [
          "language-server",
          "--protocol",
          "lsp"
        ],
        "env": {
          "DART_SDK": "/home/rubin/.local/share/flutterup/bin/cache/dart-sdk",
          "FLUTTER_ROOT": "/home/rubin/.local/share/flutterup"
        }
      },
      "initialization_options": {
        "onlyAnalyzeProjectsWithOpenFiles": true,
        "suggestFromUnimportedLibraries": false,
        "closingLabels": false,
        "flutterOutline": false,
        "outline": false
      },
      "settings": {
        "dart.enableSdkFormatter": true,
        "dart.lineLength": 120,
        "dart.completeFunctionCalls": true,
        "dart.showTodos": false
      }
    },
    "fsautocomplete": {
      "binary": {
        "path": "/usr/bin/fsautocomplete"
      },
      "initialization_options": {
        "AutomaticWorkspaceInit": true
      }
    },
    "kotlin-lsp": {
      "binary": {
        "path": "/usr/bin/kotlin-lsp",
        "arguments": [
          "--stdio"
        ]
      }
    },
    "perlnavigator-server": {
      "binary": {
        "path": "/usr/bin/perlnavigator",
        "arguments": [
          "--stdio"
        ]
      },
      "settings": {
        "perlnavigator.includePaths": [],
        "perlnavigator.perlParams": []
      }
    },
    "tailwindcss-language-server": {
      "binary": {
        "path": "/usr/bin/tailwindcss-language-server"
      },
      "settings": {
        "tailwindCSS.colorDecorators": true,
        "tailwindCSS.emmetCompletions": false,
        "tailwindCSS.includeLanguages": {},
        "tailwindCSS.files.exclude": [
          "**/.git/**",
          "**/node_modules/**",
          "**/.hg/**"
        ],
        "tailwindCSS.classAttributes": [
          "class",
          "className",
          "ngClass"
        ],
        "tailwindCSS.rootFontSize": 16,
        "tailwindCSS.showPixelEquivalents": true,
        "tailwindCSS.validate": true,
        "tailwindCSS.lint.cssConflict": "warning",
        "tailwindCSS.lint.invalidApply": "error",
        "tailwindCSS.lint.invalidConfigPath": "error",
        "tailwindCSS.lint.invalidScreen": "error",
        "tailwindCSS.lint.invalidTailwindDirective": "error",
        "tailwindCSS.lint.invalidVariant": "error",
        "tailwindCSS.lint.recommendedVariantOrder": "warning",
        "tailwindCSS.experimental.classRegex": []
      }
    },
    "vue-language-server": {
      "binary": {
        "path": "/usr/bin/vue-language-server",
        "arguments": [
          "--stdio"
        ],
        "env": {
          "NODE_ENV": "production"
        }
      },
      "settings": {
        "vue.format.script.initialIndent": false,
        "vue.format.style.initialIndent": false,
        "vue.format.template.initialIndent": true,
        "vue.format.wrapAttributes": "auto",
        "vue.inlayHints.destructuredProps": false,
        "vue.inlayHints.inlineHandlerLeading": false,
        "vue.inlayHints.missingProps": false,
        "vue.inlayHints.optionsWrapper": false,
        "vue.inlayHints.vBindShorthand": false,
        "vue.suggest.componentNameCasing": "preferPascalCase",
        "vue.suggest.defineAssignment": true,
        "vue.suggest.propNameCasing": "preferKebabCase",
        "javascript.inlayHints.enumMemberValues.enabled": false,
        "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
        "javascript.inlayHints.parameterNames.enabled": "none",
        "javascript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
        "javascript.inlayHints.parameterTypes.enabled": false,
        "javascript.inlayHints.propertyDeclarationTypes.enabled": false,
        "javascript.inlayHints.variableTypes.enabled": false,
        "javascript.inlayHints.variableTypes.suppressWhenTypeMatchesName.enabled": true,
        "typescript.inlayHints.enumMemberValues.enabled": false,
        "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
        "typescript.inlayHints.parameterNames.enabled": "none",
        "typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
        "typescript.inlayHints.parameterTypes.enabled": false,
        "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
        "typescript.inlayHints.variableTypes.enabled": false,
        "typescript.inlayHints.variableTypes.suppressWhenTypeMatchesName.enabled": true,
        "javascript.suggest.autoImports": false,
        "javascript.suggest.classMemberSnippets.enabled": true,
        "javascript.suggest.completeFunctionCalls": false,
        "javascript.suggest.includeAutomaticOptionalChainCompletions": true,
        "javascript.suggest.includeCompletionsForImportStatements": true,
        "javascript.suggest.includeCompletionsWithSnippetText": true,
        "javascript.suggest.jsdoc.generateReturns": true,
        "javascript.suggest.objectLiteralMethodSnippets.enabled": true,
        "typescript.suggest.autoImports": false,
        "typescript.suggest.classMemberSnippets.enabled": true,
        "typescript.suggest.completeFunctionCalls": false,
        "typescript.suggest.includeAutomaticOptionalChainCompletions": true,
        "typescript.suggest.includeCompletionsForImportStatements": true,
        "typescript.suggest.includeCompletionsWithSnippetText": true,
        "typescript.suggest.jsdoc.generateReturns": true,
        "typescript.suggest.objectLiteralMethodSnippets.enabled": true,
        "javascript.preferences.quoteStyle": "auto",
        "javascript.preferences.importModuleSpecifier": "shortest",
        "javascript.preferences.importModuleSpecifierEnding": "auto",
        "javascript.preferences.jsxAttributeCompletionStyle": "auto",
        "javascript.preferences.autoImportFileExcludePatterns": [],
        "typescript.preferences.quoteStyle": "auto",
        "typescript.preferences.importModuleSpecifier": "shortest",
        "typescript.preferences.importModuleSpecifierEnding": "auto",
        "typescript.preferences.jsxAttributeCompletionStyle": "auto",
        "typescript.preferences.autoImportFileExcludePatterns": [],
        "emmet.excludeLanguages": [
          "markdown"
        ],
        "emmet.preferences": {},
        "emmet.showAbbreviationSuggestions": true,
        "emmet.showExpandedAbbreviation": "always",
        "emmet.showSuggestionsAsSnippets": false,
        "emmet.syntaxProfiles": {},
        "emmet.variables": {},
        "css.completion.completePropertyWithSemicolon": true,
        "css.completion.triggerPropertyValueCompletion": true,
        "css.customData": [],
        "css.format.braceStyle": "collapse",
        "css.format.enable": true,
        "css.format.maxPreserveNewLines": null,
        "css.format.newlineBetweenRules": true,
        "css.format.newlineBetweenSelectors": true,
        "css.format.preserveNewLines": true,
        "css.format.spaceAroundSelectorSeparator": false,
        "css.hover.documentation": true,
        "css.hover.references": true,
        "less.completion.completePropertyWithSemicolon": true,
        "less.completion.triggerPropertyValueCompletion": true,
        "less.format.braceStyle": "collapse",
        "less.format.enable": true,
        "less.format.maxPreserveNewLines": null,
        "less.format.newlineBetweenRules": true,
        "less.format.newlineBetweenSelectors": true,
        "less.format.preserveNewLines": true,
        "less.format.spaceAroundSelectorSeparator": false,
        "less.hover.documentation": true,
        "less.hover.references": true,
        "scss.completion.completePropertyWithSemicolon": true,
