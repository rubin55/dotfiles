{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "mcp": {
    "servers": {
      "Computer Use": {
        "type": "local",
        "command": ["/usr/bin/computer-use-linux", "mcp"],
        "disabled": true
      },
      "Figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "Wolfram": {
        "type": "local",
        "command": [
          "/opt/wolfram/Executables/wolfram",
          "-run",
          "PacletSymbol[\"Wolfram/AgentTools\",\"Wolfram`AgentTools`StartMCPServer\"][]",
          "-noinit",
          "-noprompt"
        ],
        "environment": {
          "MCP_SERVER_NAME": "WolframLanguage",
          "WOLFRAM_BASE": "/opt/wolfram",
          "WOLFRAM_USERBASE": "/home/rubin/.Wolfram",
          "WOLFRAM_LOCALBASE": "/home/rubin/.Wolfram/Objects"
        },
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "title": {
      "model": "opencode/ling-2.6-flash-free"
    }
  }
}
